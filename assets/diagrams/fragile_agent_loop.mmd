    %% Nodes
    Input(["`Input / Context`"]):::external --> Reasoning

    %% Main Loop
    subgraph AgentLoop ["`**The Fragile Agent Loop**`"]
        direction TB
        
        Reasoning(["`**Probabilistic Reasoning**<br/>LLM: 'I think we should buy...'<br/>Non-Deterministic`"]):::userSpace
        
        TheGap{"`**THE GAP**<br/>Missing Validation<br/>Missing Governance`"}:::gapStyle
        
        Execution["`**Deterministic Execution**<br/>API: POST /trade/execute<br/>Irreversible Action`"]:::kernelSpace
        
        Reasoning ==>|Direct Control| TheGap
        TheGap ==>|Unchecked Intent| Execution
        Execution -.->|State Change / Error| Reasoning
    end

    %% Side Effects
    Execution ==>|Side Effect| SideEffect((("`**Real World**<br/>**Impact**`"))):::sideEffect
    
